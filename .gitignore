# macOS metadata
.DS_Store
._*

# Python environments and cache
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets and machine-specific config
.env
.env.*
!.env.example
*.egg-info/
.pytest_cache/

# Dữ liệu đã xử lý: sinh lại bằng `python -m dsp391m.etl`; chỉ commit manifest và báo cáo kiểm tra
data/processed/**/*.parquet
# Split đã đóng băng phải dùng chung, nên commit
!data/processed/*/splits/**/*.parquet
# Cache truy xuất/LLM theo chế độ
data/cache/
