# macOS metadata
.DS_Store
._*

# Python environments and cache
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets and machine-specific config
.env
.env.*
!.env.example
*.egg-info/
.pytest_cache/

# Dữ liệu đã xử lý: sinh lại bằng `python -m dsp391m.etl`; chỉ commit manifest và báo cáo kiểm tra
data/processed/**/*.parquet
# Split đã đóng băng phải dùng chung, nên commit
!data/processed/*/splits/**/*.parquet
# Cache truy xuất/LLM theo chế độ
data/cache/
# Bảng tên lấy từ API ngoài (PubChem/NCBI): commit để chạy được mà không cần mạng
!data/processed/*/drug_names.parquet
!data/processed/*/gene_names.parquet
!data/processed/*/dailymed_sections.parquet
!data/processed/*/chembl_map.parquet
!data/processed/*/chembl_mechanisms.parquet
# Artifact model đã fit và score cache: sinh lại được bằng `python -m dsp391m.evaluate`/trainer
results/models/
results/scores/
results/runs/**/*.pt
